# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Internal API key (used by ghost-score calculation endpoint & cron jobs)
INTERNAL_API_KEY=your-random-secret-key-here

# Assistant provider
ASSISTANT_API_KEY=asst_...
ASSISTANT_MODEL=llama-3.1-8b-instant

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_PRICE_ID=price_...

# Scraping (Python scripts)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=eyJ...

# Live Google Jobs search provider
# Adzuna is the primary live provider. SearchAPI/SerpAPI are optional
# Google Jobs-compatible fallbacks if configured.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SEARCHAPI_API_KEY=
SERPAPI_API_KEY=

# JSearch/RapidAPI fallback. Keep this off scheduled crawls on low quotas.
RAPIDAPI_KEY=
JSEARCH_DAILY_LIMIT=6

# Google OAuth / Identity Services
# NEXT_PUBLIC_GOOGLE_CLIENT_ID is the browser-safe OAuth web client ID used by
# Google One Tap. Configure the same Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
