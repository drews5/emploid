{
  "name": "emploid-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "npm run appwrite:setup",
    "scrape": "python -m scripts.harvester.main --provider greenhouse",
    "harvest": "python -m scripts.harvester.main",
    "worker:harvest": "python -m scripts.harvester.worker",
    "appwrite:setup": "node --env-file=.env.local scripts/setup-appwrite.mjs",
    "appwrite:migrate": "node --env-file=.env.local scripts/migrate-supabase-to-appwrite.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "google-auth-library": "^10.7.0",
    "next": "^14.2.0",
    "node-appwrite": "^26.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stripe": "^17.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
